# ==============================================================================
# 🌊 ORCA (ISRO PS ID: 26176) - Local Development Environment
# ==============================================================================

# Application
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ORCA Marine AI Gateway"
CORS_ORIGINS="*"

# LLM Providers (Select 'groq', 'gemini', or 'ollama')
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder_add_real_key_here
GROQ_MODEL=llama3-70b-8192

GEMINI_API_KEY=placeholder_add_real_key_here
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Bhashini Multilingual Voice API
BHASHINI_USER_ID=placeholder_user_id
BHASHINI_API_KEY=placeholder_api_key
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Database (Defaulting to local SQLite for lightweight local dev; switch to PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./orca_local.db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orca_user
POSTGRES_PASSWORD=orca_password
POSTGRES_DB=orca_marine

# External Oceanographic APIs
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
INCOIS_PFZ_API_URL=https://incois.gov.in/portal/datainfo/pfz.jsp

# Symbolic Safety Guardrails
MAX_SAFE_WAVE_HEIGHT_METERS=2.0
MAX_SAFE_WIND_SPEED_KNOTS=25.0
IMBL_DANGER_BUFFER_KM=2.0
IMBL_CAUTION_BUFFER_KM=5.0
