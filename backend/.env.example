# ==============================================================================
# 🌊 ORCA (ISRO PS ID: 26176) - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your API keys & credentials.
#
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development                       # 'development' | 'production' | 'test'
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ORCA Marine AI Gateway"
CORS_ORIGINS="*"                         # Comma-separated allowed origins or '*'

# ------------------------------------------------------------------------------
# 2. LLM INFERENCE CREDENTIALS (Groq / Gemini / Ollama)
# ------------------------------------------------------------------------------
# Default LLM Provider: 'groq' | 'gemini' | 'ollama'
LLM_PROVIDER=groq

# Groq Cloud (Recommended for ultra-low-latency Llama-3-70B voice chat)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Google Gemini API (Alternative multimodal LLM)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama (For local, 100% offline edge inference on laptop / vessel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# 3. BHASHINI MULTILINGUAL VOICE & NLP API (Govt. of India / MeitY)
# ------------------------------------------------------------------------------
# Register & obtain API credentials from: https://bhashini.gov.in/ulca
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------------------------
# 4. DATABASE & SPATIAL STORAGE (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orca_user
POSTGRES_PASSWORD=orca_password
POSTGRES_DB=orca_marine
DATABASE_URL=postgresql+asyncpg://orca_user:orca_password@localhost:5432/orca_marine

# SQLite fallback for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./orca_local.db

# ------------------------------------------------------------------------------
# 5. OCEANOGRAPHIC & SATELLITE EO DATA FEEDS
# ------------------------------------------------------------------------------
# Open-Meteo Marine API (Free, high-accuracy global wave & wind forecasts)
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# INCOIS / MOSDAC PFZ Advisory Endpoints
INCOIS_PFZ_API_URL=https://incois.gov.in/portal/datainfo/pfz.jsp
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap
INCOIS_WFS_BASE_URL=https://incois.gov.in/geoserver/wfs
INCOIS_TIMEOUT_SECONDS=4.0
INCOIS_USE_MOCK=false

# ------------------------------------------------------------------------------
# 6. SYMBOLIC SAFETY GUARDRAIL LIMITS (Zero-Hallucination Thresholds)
# ------------------------------------------------------------------------------
MAX_SAFE_WAVE_HEIGHT_METERS=2.0          # Small craft safety ceiling
MAX_SAFE_WIND_SPEED_KNOTS=25.0           # Coastal squall threshold
IMBL_DANGER_BUFFER_KM=2.0                 # Crimson alert zone
IMBL_CAUTION_BUFFER_KM=5.0                # Amber advisory zone
